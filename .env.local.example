# Voiceflow agent auth (only needed if /api/agent/* is re-enabled)
VOICEFLOW_AGENT_KEY=

# App auth - PIN-based login at /login
# AUTH_SECRET: generate with `openssl rand -base64 48`
# OWNER_APP_PIN: must be exactly 4 digits (e.g. 4829)
AUTH_SECRET=
OWNER_APP_PIN=

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings -> API in Supabase Dashboard)
# IMPORTANT: URL must NOT have a trailing /rest/v1/
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Twilio (optional - only if using SMS features)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
